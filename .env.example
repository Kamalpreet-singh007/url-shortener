# Copy to .env and adjust values: cp .env.example .env

# --- Shared (used by Docker Compose and local `go run`) ---
APP_ENV=local

PORT=8000

POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener

REDIS_PASSWORD=urlshortener
REDIS_DB=0

# --- Local `go run` / `just run` ---
# Point at services on the host. Use 5432/6379 for a local Postgres/Redis install,
# or 5434/6380 when only infra is running via Docker Compose (see below).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_ADDR=localhost:6379

# --- Docker Compose (`just compose-up`) ---
# Compose reads POSTGRES_*, REDIS_PASSWORD, REDIS_DB, and PORT from this file.
# The app container gets APP_ENV=docker and internal hostnames from docker-compose.yaml:
#   postgres:5432, redis:6379
# Migrations run automatically via the migrate service before the app starts.
#
# Host port mappings (for psql, redis-cli, or local `go run` against compose infra):
#   Postgres: localhost:5434 -> container 5432
#   Redis:    localhost:6380 -> container 6379
#
# Example when connecting from the host to compose Postgres:
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5434
#
# Example when connecting from the host to compose Redis:
#   REDIS_ADDR=localhost:6380
#   REDIS_PASSWORD=urlshortener
